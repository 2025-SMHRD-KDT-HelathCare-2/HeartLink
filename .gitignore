# ===========================================
# HeartLink .gitignore
# ===========================================

# ----- 환경변수 / 보안 (가장 중요!) -----
.env
.env.local
.env.*.local
*.pem
*.key
serviceAccountKey.json        # Firebase Admin SDK 키
google-credentials.json       # Google Cloud TTS 키
config/secrets.*

# ----- Node.js (frontend / backend 공통) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# ----- React + Vite 빌드 결과물 -----
dist/
dist-ssr/
build/
.vite/
*.local

# ----- 백엔드 업로드 임시파일 (Multer) -----
backend/uploads/
backend/tmp/
*.tmp

# ----- Python / FastAPI (ai-server) -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ----- AI 모델 가중치 / 대용량 파일 -----
# 100MB 넘는 파일은 Git LFS 또는 외부 스토리지 권장
*.pth
*.pt
*.h5
*.ckpt
*.onnx
ai-server/weights/
ai-server/data/raw/           # PhysioNet 원본 데이터셋
*.dat
*.hea
*.atr

# ----- 생성물 / 결과물 -----
*.mp3                         # TTS 음성 캐시
*.pdf                         # 단, docs/ 의 기획문서는 별도 관리
!docs/**/*.pdf                # docs 폴더 PDF는 예외로 추적
reports/output/

# ----- 로그 -----
logs/
*.log

# ----- IDE / 에디터 -----
.vscode/
.idea/
*.swp
*.swo

# ----- OS 생성 파일 -----
.DS_Store                     # macOS
Thumbs.db                     # Windows
Desktop.ini

# ----- 테스트 / 커버리지 -----
coverage/
.nyc_output/
htmlcov/
