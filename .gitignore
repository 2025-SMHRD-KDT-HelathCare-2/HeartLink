# ===========================================
# HeartLink .gitignore
# ===========================================

# ----- 환경변수 / 보안 (가장 중요!) -----
.env
.env.local
.env.*.local
*.pem
*.key
serviceAccountKey.json        # Firebase Admin SDK 키
google-credentials.json       # Google Cloud TTS 키
config/secrets.*

# ----- Node.js (frontend / backend 공통) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak
firebase-adminsdk.json
*-firebase-adminsdk-*.json
backend/src/config/firebase-adminsdk.json
backend_study_guide.md

# ----- React + Vite 빌드 결과물 -----
dist/
dist-ssr/
build/
.vite/
*.local

# ----- 백엔드 업로드 임시파일 (Multer) -----
backend/uploads/
backend/tmp/
*.tmp

# ----- Python / FastAPI (ai-server) -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ----- AI 모델 가중치 / 대용량 파일 -----
# 100MB 넘는 파일은 Git LFS 또는 외부 스토리지 권장
*.pth
*.pt
*.h5
*.ckpt
*.onnx
*.onnx.data
ai-server/weights/
ai-server/data/raw/           # PhysioNet 원본 데이터셋
*.dat
*.hea
*.atr

# ----- 생성물 / 결과물 -----
*.mp3                         # TTS 음성 캐시
*.pdf                         # 단, docs/ 의 기획문서는 별도 관리
!docs/**/*.pdf                # docs 폴더 PDF는 예외로 추적
reports/output/

# ----- 로그 -----
logs/
*.log

# ----- IDE / 에디터 -----
.vscode/
.idea/
*.swp
*.swo

# ----- OS 생성 파일 -----
.DS_Store                     # macOS
Thumbs.db                     # Windows
Desktop.ini

# ----- 테스트 / 커버리지 -----
coverage/
.nyc_output/
htmlcov/



# ============================================================================
# HeartLink .gitignore  (프로젝트 루트)
# ============================================================================

# ----------------------------------------------------------------------------
# 1) 환경변수 / 비밀키 (가장 중요! 절대 커밋 금지)
#    - Firebase 설정, API 키, DB 접속정보, JWT 시크릿 등이 들어가는 파일
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example          # 예시용 템플릿은 예외로 커밋 허용(키 값은 비워둘 것)
*.local

# 서비스 계정/인증서 류 (Firebase Admin, SSL 등)
*.pem
*.key
serviceAccount*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# ----------------------------------------------------------------------------
# 2) 의존성 폴더 (설치하면 다시 생기므로 커밋 불필요)
# ----------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.js

# ----------------------------------------------------------------------------
# 3) 프론트엔드 빌드 산출물 (Vite)
#    - dist 는 빌드로 다시 만들어지므로 커밋하지 않습니다.
# ----------------------------------------------------------------------------
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo          # tsc -b 가 만드는 증분 빌드 캐시

# ----------------------------------------------------------------------------
# 4) 로그 / 디버그 파일
# ----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ----------------------------------------------------------------------------
# 5) 캐시 / 도구
# ----------------------------------------------------------------------------
.cache/
.eslintcache
.npm/
.yarn/
coverage/              # 테스트 커버리지 리포트
.temp/
tmp/

# ----------------------------------------------------------------------------
# 6) 에디터 / OS 가 만드는 잡파일
# ----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json   # 팀 공유용 권장 확장 목록은 남기고 싶다면 예외
!.vscode/settings.json     # 팀 공통 설정을 공유한다면 예외 (아니면 이 두 줄 삭제)
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ----------------------------------------------------------------------------
# 7) 백엔드 (Python / FastAPI) — 백엔드가 같은 저장소에 있다면 사용
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version

# ----------------------------------------------------------------------------
# 8) 데이터 / 모델 / 업로드물 (용량이 크거나 민감)
#    - ResNet1D 가중치, ECG 원본 CSV, 생성된 PDF/오디오(TTS) 등
#    - 정말로 깃에 올릴 것만 남기고 나머지는 무시하세요.
# ----------------------------------------------------------------------------
*.h5
*.pt
*.pth
*.onnx
*.ckpt
uploads/
generated/
*.tmp.pdf
*.tmp.mp3
*.tmp.wav

# ----------------------------------------------------------------------------
# 9) 데이터베이스 로컬 파일 (SQLite 등)
# ----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
